using namespace std;

class Node {
private:


  string name = "nobody";
public:
  Node() = delete;
  Node(string n_) {
    name = n_;
    printf("I'm %s here.\n", name.c_str());
  }
  void Greeting() {
    printf("%s is plan a vocation.\n", name.c_str());
  }
    virtual ~Node() {
      printf("%s here, see ya.\n", name.c_str());
    }
};


int main(int argc, char *argv[])
{
  shared_ptr<Node> steve = make_shared<Node>("Steve");
  steve->Greeting();

  return 0;
}
