<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%
    if (page.title) { %><%= page.title %> | <% }
  %><%= config.title %></title>
  <meta name="description" content="<%= config.description %>">
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #14161a;
      color: #d8dde5;
      font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
            "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
    }
    header.site {
      padding: 18px 24px;
      border-bottom: 1px solid #262b33;
    }
    header.site h1 { margin: 0; font-size: 17px; letter-spacing: .01em; }
    header.site h1 a { color: #d8dde5; text-decoration: none; }
    header.site p { margin: 2px 0 0; color: #8b93a1; font-size: 13px; }
    main { padding: 24px; max-width: 1400px; }
    a { color: #7fb2ff; }
    footer.site {
      padding: 16px 24px;
      border-top: 1px solid #262b33;
      color: #79808d;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <header class="site">
    <h1><a href="<%- url_for('/') %>"><%= config.title %></a></h1>
    <% if (config.subtitle) { %><p><%= config.subtitle %></p><% } %>
  </header>

  <main>
    <%- body %>
  </main>

  <footer class="site">
    Built from the same sources as the desktop application. The skeleton files
    you pick are read locally and never uploaded.
  </footer>
</body>
</html>
